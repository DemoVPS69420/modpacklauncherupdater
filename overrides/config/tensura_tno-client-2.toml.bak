[compatibility_patches]
	#Delay VanillaBackport sheep undercoat layer registration until its config is ready.
	vanillaBackportDelayedSheepLayer = true
	#Make Curios SlotAttribute.getOrCreate thread-safe to avoid creative tooltip ConcurrentModificationException.
	curiosSlotAttributeConcurrency = true
	#Outline Tensura magic ores in white while Magic Sense is active.
	magicSenseOreXray = true
